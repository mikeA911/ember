{
  "name": "kb-sandbox-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "node --env-file=.env.local scripts/check-db-state.mjs",
    "db:seed-kbs": "node --env-file=.env.local scripts/seed-knowledge-bases.mjs",
    "db:seed-users": "node --env-file=.env.local scripts/seed-test-users.mjs",
    "db:build-sql": "node scripts/build-migration-sql.mjs",
    "wiki:export": "node --env-file=.env.local scripts/export-approved-wikis.mjs",
    "methods:export": "node --env-file=.env.local scripts/export-approved-wikis.mjs --methods-only"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@langchain/langgraph": "^1.4.9",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "2.45.4",
    "@types/js-yaml": "^4.0.9",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "jose": "^6.2.10",
    "js-yaml": "^5.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "next": "16.3.0",
    "openai": "^6.16.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.4.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "unpdf": "^1.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
