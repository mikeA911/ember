# Supabase cloud (<ref>.supabase.co) or a self-hosted stack's public API
# URL (https://<api-domain>) -- see docs/guides/ember-on-self-hosted-supabase.md.
# On self-hosted, the anon key is the stack's SUPABASE_PUBLISHABLE_KEY and the
# service-role key is its SUPABASE_SECRET_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://cstuqporwuhkuysydxyc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where builders email a request for an account, with their reason
# (/register). Self-registration is off -- you reply to accept or decline,
# then create the account from /admin.
EMBER_ACCESS_REQUEST_EMAIL=

# Shared workspace sessions (docs/dev-request-shared-workspace-sessions.md).
# Off unless "true"; needs migration 20261023100001_collaboration_sessions.sql.
# NEXT_PUBLIC values are fixed at build time -- rebuild after changing it.
NEXT_PUBLIC_EMBER_COLLABORATION=false

# Direct Postgres connection string (Supabase dashboard -> Connect, or for a
# self-hosted stack the session-mode string through an SSH tunnel). Only
# needed by the scripts that run SQL directly (scripts/run-migrations.mjs,
# scripts/import-cebu-ng911.mjs); the app itself never uses it.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.cstuqporwuhkuysydxyc.supabase.co:5432/postgres

# Canonical public origin, no trailing slash -- used for the Blog's
# sitemap, robots.txt, canonical URLs, and social/JSON-LD metadata. Falls
# back to http://localhost:3000 when unset (see src/lib/env.ts).
NEXT_PUBLIC_SITE_URL=https://kbsandbox.tech

# Only the key for a provider actually enabled in ai_providers (admin AI
# Config page) is required at runtime -- see src/lib/ai/registry.ts's
# resolveApiKey(), which looks up whatever env var name is stored on that
# provider's row. All five are listed here so switching the default
# provider doesn't need a redeploy.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=

GATEWAY_API_KEY=
DELEGATION_HS256_SECRET=

# Ember's search_web tool (pre-sales/competitive web research via Tavily).
# Tool is simply omitted from Ember's tool list when this is unset -- see
# src/lib/env.ts's tavilyApiKey() and loop.ts's tools-array gate.
TAVILY_API_KEY=

# AI-processing policy for "foundational" calls -- chunk enrichment and
# embeddings (src/lib/ai/sensitivity.ts's AICallPurpose). Unset/anything
# else: they may use any model. Exactly 'true': they're checked against the
# information-sensitivity ceilings like chat and other content calls, for a
# deployment whose client forbids document text reaching a cloud model.
EMBER_GATE_FOUNDATIONAL_AI=

# Protects src/app/api/cron/presentations -- Vercel auto-sends this exact
# value as `Authorization: Bearer <value>` on its cron requests when the env
# var is named literally CRON_SECRET (see vercel.json's crons entry). Any
# random value works locally for manual curl testing.
CRON_SECRET=

# External MCP server (docs/guides/ember-mcp-oauth-setup.md). Off unless
# exactly 'true': /api/mcp answers 503 and the OAuth consent page refuses.
EMBER_MCP_ENABLED=
